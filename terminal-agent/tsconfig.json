{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "node",
		"lib": ["ES2022"],
		"outDir": "./dist",
		"rootDir": ".",
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": false,
		"sourceMap": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": false,
		"noEmit": false
	},
	"include": ["*.ts", "src/index.ts", "src/command-result.ts", "src/agent.ts", "src/terminal.ts"],
	"exclude": ["node_modules", "dist"]
}
